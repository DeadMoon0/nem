<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PublishAot>False</PublishAot>
		<InvariantGlobalization>true</InvariantGlobalization>
		<!--<GenerateDocumentationFile>true</GenerateDocumentationFile>--><!--//TODO: Add this later-->
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Title>nem</Title>
		<PackageId>nem</PackageId>
		<Authors>DeadMoon0</Authors>
		<Product>nem</Product>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageTags>Node, NPM, Package, Package Manager</PackageTags>
		<Description>Local Node.js environment manager for projects</Description>
		<Version>1.0.0</Version>
		<PackageProjectUrl>https://github.com/DeadMoon0/NEM</PackageProjectUrl>
		<RepositoryUrl>https://github.com/DeadMoon0/NEM.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<Copyright>Copyright (c) DeadMoon0 2026</Copyright>
		<PackageReleaseNotes>Initial public release.</PackageReleaseNotes>
		<PackAsTool>True</PackAsTool>
		<ToolCommandName>nem</ToolCommandName>
		<!-- The proxy templates (NAME.bat/NAME.ps1/NAME) ship under tools/ on purpose; -->
		<!-- they are data for nem, not NuGet install scripts, so NU5111 is expected. -->
		<NoWarn>$(NoWarn);NU5111</NoWarn>
		<!--<SelfContained>true</SelfContained>
		<PublishSingleFile>true</PublishSingleFile>-->
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
	  <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
	  <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
	</PropertyGroup>

	<ItemGroup>
	  <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
	  <PackageReference Include="Spectre.Console" Version="0.57.2" />
	  <PackageReference Include="Spectre.Console.Cli" Version="0.55.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\nem.Common\nem.Common.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="Resources\ResolveVersion.js">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </None>
  <None Update="Resources\AuditEnv.js">
    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
  </None>
  <None Update="ProxyFiles\NAME">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="ProxyFiles\NAME.bat">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <None Update="ProxyFiles\NAME.ps1">
	    <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	  </None>
	  <!-- The repo-root README.md is the package readme. -->
	  <None Include="..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
	  <Folder Include="ProxyFiles\" />
  <Folder Include="Resources\" />
	</ItemGroup>

</Project>
